### DISCORD SETTINGS ###
# The bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: command prefix for classic (message) commands.
COMMAND_PREFIX=!

# Optional: comma-separated guild IDs to sync slash commands to instantly.
# Leave empty to sync globally (can take up to an hour to propagate).
GUILD_IDS=

# Optional: comma-separated Discord user IDs allowed to run the light commands.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

### HUE SETTINGS ###
HUE_APP_KEY=
HUE_BRIDGE_IP=

### LOCATION SETTINGS ###
# Decimal degrees, e.g. from Google Maps (right-click a spot, click the
# coordinates to copy). South/West are negative. Used for the sunrise check.
LATITUDE=
LONGITUDE=

### DATABASE SETTINGS ###
# PostgreSQL container credentials (used by the db service).
# Postgres only reads these when its volume is first created.
POSTGRES_USER=aurorahue
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aurorahue

# Database URL used by the bot. Host "db" is the compose service name.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://aurorahue:change-me@db:5432/aurorahue

# Run "alembic upgrade head" on start.
RUN_MIGRATIONS=true

### LIGHT ACCESS ###
# Which lights the bot may control (whitelist or blacklist of light UUIDs).
# Read once at start-up; restart the bot after editing it.
LIGHTS_CONFIG=configs/lights.json
